{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "heybio",
  "main": "./workers/app.ts",
  "compatibility_date": "2026-10-10",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "vars": {
    "BILLING_JOBS_ENABLED": "false"
  }
}