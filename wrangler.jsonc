{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "heybio",
  "main": "./workers/app.ts",
  "compatibility_date": "2026-10-10",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "20261701",
      "simple": { "limit": 60, "period": 60 }
    }
  ],
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "vars": {
    "BILLING_JOBS_ENABLED": "true"
  }
}