#
# Local Cloudflare Workers development:
# Copy values to .dev.vars.
#
# Never commit real credentials.
# Never expose server keys in browser code.

SUPABASE_URL=https://YOUR_PROJECT.supabase.co

SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY

RAZORPAY_KEY_ID=YOUR_RAZORPAY_KEY_ID

RAZORPAY_KEY_SECRET=YOUR_SERVER_ONLY_RAZORPAY_SECRET

RAZORPAY_WEBHOOK_SECRET=YOUR_SERVER_ONLY_WEBHOOK_SECRET

TURNSTILE_SECRET_KEY=YOUR_SERVER_ONLY_TURNSTILE_SECRET

# Keep disabled until payment reconciliation
# and webhook processing have been tested.

BILLING_JOBS_ENABLED=false